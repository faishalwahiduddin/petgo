<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/qa_btn_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/qa_icon_0"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name" />
        <TextView
            android:id="@+id/qa_label_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/quick_notif_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qa_btn_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/qa_icon_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name" />
        <TextView
            android:id="@+id/qa_label_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/quick_notif_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qa_btn_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/qa_icon_2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name" />
        <TextView
            android:id="@+id/qa_label_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/quick_notif_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qa_btn_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:id="@+id/qa_icon_3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/app_name" />
        <TextView
            android:id="@+id/qa_label_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/quick_notif_label" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/qa_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_qa_close"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Dismiss" />

</LinearLayout>
